set fallback

mod boy
mod pub
mod relay
mod sub
mod web

# Run the web demo (default).
default:
    #!/usr/bin/env bash
    set -euo pipefail

    bun install

    pids=()
    cleanup() {
    	local pid
    	for pid in "${pids[@]:-}"; do
    		kill "$pid" 2>/dev/null || true
    	done
    }
    trap cleanup EXIT INT TERM

    just relay &
    pids+=($!)

    (
    	just wait
    	just pub bbb
    ) &
    pids+=($!)

    (
    	just wait
    	just web
    ) &
    pids+=($!)

    status=0
    wait -n "${pids[@]}" || status=$?
    cleanup
    wait "${pids[@]}" 2>/dev/null || true
    exit "$status"
# Wait for the localhost relay to be ready by repeatedly requesting the cert
[private]
wait url="http://localhost:4443/certificate.sha256":
    #!/usr/bin/env bash
    set -euo pipefail
    for i in $(seq 1 600); do
    	curl -sf "{{ url }}" > /dev/null 2>&1 && exit 0
    	sleep 1
    done
    exit 1
# Throttle UDP traffic for testing (macOS only, requires sudo).
throttle:
    throttle/enable
