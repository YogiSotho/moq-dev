#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)

if command -v pwsh.exe >/dev/null 2>&1; then
	exec pwsh.exe -NoProfile -ExecutionPolicy Bypass -File "$repo_root/scripts/pre-push.ps1"
fi

if command -v pwsh >/dev/null 2>&1; then
	exec pwsh -NoProfile -File "$repo_root/scripts/pre-push.ps1"
fi

echo "PowerShell was not found. Install pwsh or run scripts/pre-push.ps1 manually." >&2
exit 1#!/bin/sh
